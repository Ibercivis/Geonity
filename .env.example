# Opcional: si NO defines esto, en dev se usará el proxy de Vite (/api -> https://geonity.ibercivis.es)
VITE_API_BASE_URL=

# Target del proxy de Vite para /api en desarrollo.
# Para tu caso (puerto 10003 sin https):
# VITE_API_PROXY_TARGET=http://geonity.ibercivis.es:10003
VITE_API_PROXY_TARGET=

# (Opcional) Si SOLO el endpoint de columnas vive en otro host/puerto,
# puedes mantener /api apuntando al backend normal y redirigir únicamente:
# GET/POST/PATCH/DELETE /api/projects/<id>/observation-fields/
# al servidor/puerto alternativo.
# Ejemplo:
# VITE_API_COLUMNS_PROXY_TARGET=http://geonity.ibercivis.es:10003
VITE_API_COLUMNS_PROXY_TARGET=

# (Opcional) Proxy específico para /api/observations/<id>/admin-fields/.
# Si no se define, usa VITE_API_COLUMNS_PROXY_TARGET.
# VITE_API_ADMIN_FIELDS_PROXY_TARGET=http://geonity.ibercivis.es:10003

# Requerido para mostrar el mapa (Mapbox)
VITE_MAPBOX_TOKEN=

# Google OAuth
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=https://geonity-admin.ibercivis.es/auth/google/callback
VITE_GOOGLE_REDIRECT_URI_DEV=https://geonity-admin.ibercivis.es:10003/auth/google/callback
